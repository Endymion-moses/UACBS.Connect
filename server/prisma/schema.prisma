generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int              @id @default(autoincrement())
  fullName  String
  email     String           @unique
  password  String
  role      Role
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  admin     AdminProfile?
  lecturer  LecturerProfile?
  student   StudentProfile?
  notifications Notification[]
}

model StudentProfile {
  id          Int    @id @default(autoincrement())
  department  String
  programme   String
  phoneNumber String @unique
  userId      Int    @unique
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]
}

model LecturerProfile {
  id             Int    @id @default(autoincrement())
  department     String
  specialization String
  officeLocation String
  phoneNumber    String @unique
  userId         Int    @unique
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  availability   LecturerAvailability[]
  appointments   Appointment[]
}

model AdminProfile {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  STUDENT
  LECTURER
  ADMIN
}

enum AppointmentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Appointment {
  id              Int               @id @default(autoincrement())
  studentId       Int
  lecturerId      Int
  appointmentDate String
  timeSlot        String
  reason          String
  status          AppointmentStatus @default(PENDING)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  student         StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lecturer        LecturerProfile   @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  notifications   Notification[]

  @@unique([lecturerId, appointmentDate, timeSlot])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String
  title     String
  message   String
  appointmentId Int?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
}

model LecturerAvailability {
  id          Int             @id @default(autoincrement())
  lecturerId  Int
  dayOfWeek   String          // e.g. "Monday"
  timeSlot    String          // e.g. "08:00-09:00"
  isAvailable Boolean         @default(false)

  lecturer    LecturerProfile @relation(fields: [lecturerId], references: [id], onDelete: Cascade)

  @@unique([lecturerId, dayOfWeek, timeSlot])
}
