generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int              @id @default(autoincrement())
  fullName  String
  email     String           @unique
  password  String
  role      Role
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  admin     AdminProfile?
  lecturer  LecturerProfile?
  student   StudentProfile?
}

model StudentProfile {
  id          Int    @id @default(autoincrement())
  department  String
  programme   String
  phoneNumber String @unique
  userId      Int    @unique
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LecturerProfile {
  id             Int    @id @default(autoincrement())
  department     String
  specialization String
  officeLocation String
  phoneNumber    String @unique
  userId         Int    @unique
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  availability   LecturerAvailability[]
}

model AdminProfile {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  STUDENT
  LECTURER
  ADMIN
}

model LecturerAvailability {
  id          Int             @id @default(autoincrement())
  lecturerId  Int
  dayOfWeek   String          // e.g. "Monday"
  timeSlot    String          // e.g. "08:00-09:00"
  isAvailable Boolean         @default(false)

  lecturer    LecturerProfile @relation(fields: [lecturerId], references: [id], onDelete: Cascade)

  @@unique([lecturerId, dayOfWeek, timeSlot])
}
